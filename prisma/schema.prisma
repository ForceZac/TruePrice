// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────

// (none yet — using string fields for flexibility in v1)

// ─── Models ────────────────────────────────────────────────────────────────

model ProductCategory {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  overheadPercent Float
  description     String?
  createdAt       DateTime  @default(now())

  products        Product[]
}

model Product {
  id               String          @id @default(cuid())
  name             String
  brand            String?
  upc              String?         @unique
  ean              String?         @unique
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  categoryId       String
  subcategory      String?
  description      String?
  imageUrl         String?
  retailPriceCents Int?
  weightGrams      Float?
  countryOfOrigin  String?
  ingredients      String?
  source           String
  sourceId         String?
  lastLookedUp     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  materials        ProductMaterial[]
  costBreakdowns   CostBreakdown[]
  savedByUsers     SavedProduct[]
  recentlyViewedBy RecentlyViewed[]
}

model Material {
  id           String    @id @default(cuid())
  name         String    @unique
  commodityKey String?
  unit         String
  categoryTag  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  productLinks     ProductMaterial[]
  commodityPrices  CommodityPrice[]
}

model ProductMaterial {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId  String
  material    Material @relation(fields: [materialId], references: [id])
  percentage  Float?
  weightGrams Float?
  source      String

  @@unique([productId, materialId])
  @@index([productId])
  @@index([materialId])
}

model CommodityPrice {
  id              String   @id @default(cuid())
  materialId      String
  material        Material @relation(fields: [materialId], references: [id])
  pricePerKgCents Int
  source          String
  fetchedAt       DateTime
  createdAt       DateTime @default(now())

  @@index([materialId])
  @@index([fetchedAt])
}

model CostBreakdown {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialCostCents  Int
  laborCostCents     Int
  overheadCostCents  Int
  shippingCostCents  Int
  totalCostCents     Int
  retailPriceCents   Int?
  markupPercent      Float?
  confidenceScore    Float
  confidenceReason   String
  confidence         String   @default("LOW")
  methodology        String
  calculatedAt       DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([calculatedAt])
  @@index([updatedAt])
  @@index([markupPercent(sort: Desc)])
}

model LaborRate {
  id              String   @id @default(cuid())
  countryCode     String   @unique
  countryName     String
  hourlyRateCents Int
  source          String
  lastUpdated     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Auth (NextAuth v5 / Auth.js) ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  savedProducts  SavedProduct[]
  recentlyViewed RecentlyViewed[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Watchlist & Recently Viewed ───────────────────────────────────────────

model SavedProduct {
  userId    String
  productId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
}

model RecentlyViewed {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId])
  @@index([viewedAt])
}
