{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/refresh-retail-prices",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/re-estimate",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/send-digest",
      "schedule": "0 8 * * 6"
    }
  ]
}
